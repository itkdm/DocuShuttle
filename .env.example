# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Storage uses the private `paperduck-private` Supabase bucket with user RLS.
# No service-role or separate object-storage credential is required at runtime.

# Text generation (OpenAI-compatible DeepSeek API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Image generation through APIMart
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai
APIMART_IMAGE_MODEL=gpt-image-2

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional development-only truncated content preview; never enable in production.
# PAPERDUCK_LOG_CONTENT=preview
